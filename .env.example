# ---- Supabase (optional) -------------------------------------------------
# Leave these blank to run Activa with the built-in local file-backed store.
# Fill them in to use Supabase Auth, Postgres, and Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sessions ------------------------------------------------------------
# Secret used to sign local session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-in-production
